{
  "name": "drwr",
  "version": "0.1.0",
  "description": "A zero-dependency, framework-agnostic bottom sheet / drawer component",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite demo",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "drawer",
    "sheet",
    "bottom-sheet",
    "modal",
    "mobile",
    "gesture",
    "drag",
    "spring",
    "a11y"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  }
}
